                    "type": "string",
                    "maxLength": 18,
                    "pattern": "^\\d+$"
                }
            },
            "additionalProperties": false
        },
        "body": {
            "description": "Resource create operation model.",
            "type": "object",
            "properties": {
                "description": {
                    "type": ["string", "null"]
                },
                "is_ads_only": {
                    "description": "If set to `true`, the board will be ad-only and can store ad-only Pins.",
                    "type": "boolean"
                },
                "name": {
                    "description": "    Name of the board.\n\n    **Note:** If you create an ad-only board by setting `is_ads_only`\n    to `true`, the board name automatically becomes \"Ad-only Pins\"",
                    "type": "string"
                },
                "privacy": {
                    "description": "    Privacy setting for a board. Learn more about [secret](https://help.pinterest.com/en/article/secret-boards)\n    boards and [protected](https://help.pinteres",
                    "type": "string",
                    "enum": ["PUBLIC", "PROTECTED", "SECRET"]
                }
            },
            "required": ["name"]
        },
        "bodyRequired": true
    },
