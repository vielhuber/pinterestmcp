    {
        "name": "boardsCreate",
        "path": "/boards",
        "method": "POST",
        "write": true,
        "description": "Create board.",
        "url": "https://developers.pinterest.com/docs/api/v5/#operation/boards/create",
        "parameters": {
            "type": "object",
            "properties": {
